{
  "name": "opencara",
  "version": "0.0.0",
  "description": "OpenCara agent-host CLI: register a machine as an agent host and run dispatched agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenCara/OpenCara.git",
    "directory": "packages/cli"
  },
  "homepage": "https://opencara.com",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "opencara": "./dist/bin.js"
  },
  "main": "./dist/bin.js",
  "files": [
    "dist/bin.js",
    "dist/chunks"
  ],
  "scripts": {
    "build": "tsc -b && node build.mjs",
    "dev": "tsx watch src/bin.ts",
    "start": "node dist/bin.js",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test --test-reporter=spec src/runner/__tests__/*.test.ts src/commands/__tests__/*.test.ts src/transport/__tests__/*.test.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "ws": "^8.22.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@opencara/shared": "workspace:*",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.2"
  }
}
