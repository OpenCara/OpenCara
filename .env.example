# Orchestrator
PORT=3030
PUBLIC_BASE_URL=https://example.com
DATABASE_URL=postgres://opencara:opencara@localhost:5433/opencara
# Pool tuning (defaults are sane; see packages/orchestrator/src/db/client.ts)
#DB_POOL_MAX=12
#DB_SSL=require            # require|disable — overrides the hostname guess
#DB_STATEMENT_TIMEOUT_MS=30000
#DB_POOL_MONITOR_INTERVAL_MS=30000   # pg_stat_activity sampler; 0 disables
# Retention: terminal agent_runs/flow_runs, unreferenced platform_events and
# expired sessions older than this many days are pruned on boot + daily.
# 0 disables. Default 7.
#DATA_RETENTION_DAYS=7
# Auth session lookup hardening
#AUTH_SESSION_TIMEOUT_MS=3000        # DB wait budget before 503
#AUTH_SESSION_CACHE_TTL_MS=10000     # fresh-cache window
#AUTH_SESSION_STALE_MS=30000         # serve-stale-while-revalidating; 0 off
#SLOW_REQUEST_MS=2000                # log /api requests slower than this

# GitHub App credentials (register at github.com/organizations/<org>/settings/apps/new)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=/abs/path/to/opencara.private-key.pem
# Webhook secret configured on the GitHub App (used to verify webhook signatures).
# Required — the orchestrator refuses to boot without one (openssl rand -hex 32).
GITHUB_WEBHOOK_SECRET=

# Azure DevOps (optional) — Microsoft Entra ID app registration.
# Leave unset to run GitHub-only; setting ANY of these requires the first two.
# Register at portal.azure.com > Microsoft Entra ID > App registrations, add the
# redirect URI <PUBLIC_BASE_URL>/auth/azure/callback, and grant the app the
# Azure DevOps delegated permissions. All four are required:
#   vso.code_write        repos, PRs, PR threads, reviewer votes, labels
#   vso.work_write        work items
#   vso.notification_write  service hook subscriptions (adding a repo creates them)
#   vso.profile           profile/accounts lookup used to list organizations
# (`vso.threads_full` is a PAT scope name, not an Entra scope — it does not exist here.)
# Entra rather than an Azure DevOps OAuth app: Microsoft stopped accepting new
# Azure DevOps OAuth registrations in April 2025 and is retiring the service.
#AZDO_ENTRA_CLIENT_ID=
#AZDO_ENTRA_CLIENT_SECRET=
# "common" (default), "organizations", or a specific tenant GUID.
#AZDO_ENTRA_TENANT=common

# Max wall-clock per dispatched agent job in ms (default 3600000 = 60 min; 0 disables)
#JOB_TIMEOUT_MS=3600000

# Sessions (openssl rand -hex 32)
SESSION_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=ocara_sid
SESSION_TTL_DAYS=14

# Agent host
ORCHESTRATOR_URL=http://localhost:3030
AGENT_HOST_TOKEN=changeme
